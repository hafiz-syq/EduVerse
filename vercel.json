{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["sin1"],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/materi", "destination": "/index.html" },
    { "source": "/modul/:slug", "destination": "/index.html" },
    { "source": "/kuis", "destination": "/index.html" },
    { "source": "/koding", "destination": "/index.html" },
    { "source": "/diskusi", "destination": "/index.html" },
    { "source": "/diskusi/:id", "destination": "/index.html" },
    { "source": "/arena", "destination": "/index.html" },
    { "source": "/arena/:id", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/profil", "destination": "/index.html" },
    { "source": "/masuk", "destination": "/index.html" },
    { "source": "/kebijakan-privasi", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
