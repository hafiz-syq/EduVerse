# Contoh berkas environment. Salin ke .env untuk penggunaan lokal; di Netlify isi
# lewat Site Settings → Build & deploy → Environment, jangan menyalin berkas ini.
# Berkas ini hanya memuat NAMA variabel. Jangan pernah menulis nilai rahasia asli
# di sini, di source, di log, atau di artefak frontend.

# --- Database (wajib) ---
# URL Postgres. Untuk serverless pakai endpoint pooled (biasanya bernada -pooler)
# supaya koneksi bisa dipakai ulang antar invikasi Function.
DATABASE_URL=
# Opsional: jumlah koneksi maksimum di pool per kontainer Function (default 3).
DATABASE_POOL_MAX=
# Opsional: isi "disable" hanya untuk server Postgres lokal tanpa TLS.
# Selain nilai itu koneksi memakai TLS dengan verifikasi sertifikat.
DATABASE_SSL=

# --- Identitas EduVerse (wajib) ---
# Minimum 16 karakter. Tanpanya Function menolak start (session_secret_missing).
# Ganti bila bocor; sesi lama ikut hangus.
APP_SESSION_SECRET=
# Daftar identitas (email) admin, dipisah koma.
APP_ADMIN_IDENTITIES=

# --- Masuk dengan akun Google / GitHub (opsional per penyedia) ---
# Satu penyedia baru muncul di halaman masuk bila ID klien dan rahasianya keduanya diisi.
# Daftar redirect URI di konsol penyedia:
#   https://<domain situs>/functions/v1/app/api/auth/callback
APP_GOOGLE_CLIENT_ID=
APP_GOOGLE_CLIENT_SECRET=
APP_GITHUB_CLIENT_ID=
APP_GITHUB_CLIENT_SECRET=
# Opsional: paksa asal redirect URL (dipakai bila fungsi berada di belakang proxy
# atau domain kustom sehingga alamat permintaan tidak sama dengan alamat publik).
APP_PUBLIC_URL=
